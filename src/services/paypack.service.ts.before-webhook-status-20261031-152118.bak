import {
  createHmac,
  timingSafeEqual,
} from 'node:crypto';
import { AppError } from '../utils/appError.js';

type PaypackMode = 'development' | 'production';
type PaypackTransactionStatus = 'pending' | 'successful' | 'failed';

interface PaypackConfig {
  clientId: string;
  clientSecret: string;
  webhookSecret: string;
  baseUrl: string;
  mode: PaypackMode;
}

interface PaypackAuthResponse {
  access?: string;
  refresh?: string;
  expires?: string;
}

interface PaypackTransaction {
  ref?: string;
  amount?: number;
  kind?: string;
  status?: string;
  client?: string;
}

export interface PaypackCashInResult {
  ref: string;
  amount: number;
  kind: 'CASHIN';
  status: PaypackTransactionStatus;
}

export interface PaypackWebhookPayload {
  event_id: string;
  kind: 'transaction:processed';
  data: {
    ref: string;
    kind: 'CASHIN' | 'CASHOUT';
    amount: number;
    status: PaypackTransactionStatus;
    client?: string;
  };
}

export class PaypackRequestError extends AppError {
  constructor(
    message: string,
    public readonly definitivelyRejected: boolean
  ) {
    super(message, definitivelyRejected ? 400 : 503);
  }
}

export class PaypackService {
  private accessToken: string | null = null;
  private tokenExpiresAt = 0;

  private getConfig(): PaypackConfig {
    const {
      PAYPACK_CLIENT_ID,
      PAYPACK_CLIENT_SECRET,
      PAYPACK_WEBHOOK_SIGN_KEY,
      PAYPACK_BASE_URL,
      PAYPACK_WEBHOOK_MODE,
    } = process.env;

    if (
      !PAYPACK_CLIENT_ID ||
      !PAYPACK_CLIENT_SECRET ||
      !PAYPACK_WEBHOOK_SIGN_KEY
    ) {
      throw new AppError(
        'Paypack is not configured. Required credentials are missing.',
        503
      );
    }

    const mode = PAYPACK_WEBHOOK_MODE;

    if (mode !== 'development' && mode !== 'production') {
      throw new AppError(
        'PAYPACK_WEBHOOK_MODE must explicitly be development or production.',
        503
      );
    }

    const baseUrl = PAYPACK_BASE_URL || 'https://payments.paypack.rw/api';

    let parsedUrl: URL;

    try {
      parsedUrl = new URL(baseUrl);
    } catch {
      throw new AppError('Paypack API URL is invalid.', 500);
    }

    if (
      parsedUrl.protocol !== 'https:' ||
      parsedUrl.hostname !== 'payments.paypack.rw'
    ) {
      throw new AppError(
        'Paypack API must use its verified HTTPS endpoint.',
        500
      );
    }

    return {
      clientId: PAYPACK_CLIENT_ID,
      clientSecret: PAYPACK_CLIENT_SECRET,
      webhookSecret: PAYPACK_WEBHOOK_SIGN_KEY,
      baseUrl: baseUrl.replace(/\/+$/, ''),
      mode,
    };
  }

  private async getAccessToken(): Promise<string> {
    const config = this.getConfig();

    if (
      this.accessToken &&
      Date.now() < this.tokenExpiresAt
    ) {
      return this.accessToken;
    }

    let response: Response;

    try {
      response = await fetch(
        `${config.baseUrl}/auth/agents/authorize`,
        {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            client_id: config.clientId,
            client_secret: config.clientSecret,
          }),
          signal: AbortSignal.timeout(20000),
        }
      );
    } catch {
      throw new PaypackRequestError(
        'Paypack authentication could not be reached.',
        false
      );
    }

    let result: PaypackAuthResponse;

    try {
      result = (await response.json()) as PaypackAuthResponse;
    } catch {
      throw new PaypackRequestError(
        'Paypack returned an unreadable authentication response.',
        false
      );
    }

    if (!response.ok || typeof result.access !== 'string' || !result.access) {
      throw new PaypackRequestError(
        'Paypack authentication failed. Check the configured credentials.',
        false
      );
    }

    this.accessToken = result.access;

    // Refresh the token before its documented short lifetime expires.
    this.tokenExpiresAt = Date.now() + 10 * 60 * 1000;

    return this.accessToken;
  }

  private async request<T>(
    path: string,
    options: {
      method?: 'GET' | 'POST';
      body?: Record<string, string | number>;
      idempotencyKey?: string;
      includeWebhookMode?: boolean;
    } = {}
  ): Promise<T> {
    const config = this.getConfig();
    const token = await this.getAccessToken();

    const headers: Record<string, string> = {
      Accept: 'application/json',
      'Content-Type': 'application/json',
      Authorization: `Bearer ${token}`,
    };

    if (options.idempotencyKey) {
      if (
        options.idempotencyKey.length > 32 ||
        !/^[a-zA-Z0-9_-]+$/.test(options.idempotencyKey)
      ) {
        throw new AppError(
          'Paypack idempotency key must contain 1-32 safe characters.',
          400
        );
      }

      headers['Idempotency-Key'] = options.idempotencyKey;
    }

    if (options.includeWebhookMode) {
      headers['X-Webhook-Mode'] = config.mode;
    }

    let response: Response;

    try {
      response = await fetch(`${config.baseUrl}${path}`, {
        method: options.method || 'GET',
        headers,
        ...(options.body
          ? { body: JSON.stringify(options.body) }
          : {}),
        signal: AbortSignal.timeout(20000),
      });
    } catch {
      throw new PaypackRequestError(
        'Paypack could not be reached. The transaction outcome may be uncertain. Check its status before retrying.',
        false
      );
    }

    let result: T;

    try {
      result = (await response.json()) as T;
    } catch {
      throw new PaypackRequestError(
        'Paypack returned an unreadable response. Verify transaction status before retrying.',
        false
      );
    }

    if (!response.ok) {
      throw new PaypackRequestError(
        `Paypack request failed with HTTP ${response.status}.`,
        (response.status === 400 || response.status === 422)
      );
    }

    return result;
  }

  public async cashIn(input: {
    phoneNumber: string;
    amount: number;
    idempotencyKey: string;
  }): Promise<PaypackCashInResult> {
    if (!Number.isSafeInteger(input.amount) || input.amount <= 0) {
      throw new AppError(
        'Paypack requires a positive integer RWF amount.',
        400
      );
    }

    const digits = input.phoneNumber.replace(/\D/g, '');

    let localNumber: string;

    if (/^07\d{8}$/.test(digits)) {
      localNumber = digits;
    } else if (/^2507\d{8}$/.test(digits)) {
      localNumber = `0${digits.slice(3)}`;
    } else if (/^7\d{8}$/.test(digits)) {
      localNumber = `0${digits}`;
    } else {
      throw new AppError(
        'A valid Rwanda Mobile Money phone number is required.',
        400
      );
    }

    const result = await this.request<PaypackTransaction>(
      '/transactions/cashin',
      {
        method: 'POST',
        body: {
          amount: input.amount,
          number: localNumber,
        },
        idempotencyKey: input.idempotencyKey,
        includeWebhookMode: true,
      }
    );

    if (
      typeof result.ref !== 'string' ||
      !result.ref.trim() ||
      Number(result.amount) !== input.amount ||
      result.kind !== 'CASHIN' ||
      !['pending', 'successful', 'failed'].includes(
        String(result.status).toLowerCase()
      )
    ) {
      throw new PaypackRequestError(
        'Paypack returned an invalid or mismatched cash-in response.',
        false
      );
    }

    return {
      ref: result.ref,
      amount: input.amount,
      kind: 'CASHIN',
      status: result.status!.toLowerCase() as PaypackTransactionStatus,
    };
  }

  public async findTransaction(ref: string): Promise<PaypackCashInResult> {
    if (!ref.trim()) {
      throw new AppError('Paypack transaction reference is required.', 400);
    }

    const result = await this.request<PaypackTransaction>(
      `/transactions/find/${encodeURIComponent(ref)}`
    );

    const amount = Number(result.amount);
    const status = String(result.status).toLowerCase();

    if (
      result.ref !== ref ||
      result.kind !== 'CASHIN' ||
      !Number.isSafeInteger(amount) ||
      amount <= 0 ||
      !['pending', 'successful', 'failed'].includes(status)
    ) {
      throw new PaypackRequestError(
        'Paypack transaction details are invalid or do not match.',
        false
      );
    }

    return {
      ref,
      amount,
      kind: 'CASHIN',
      status: status as PaypackTransactionStatus,
    };
  }

  public verifyWebhookMode(modeHeader: string | undefined): boolean {
    return modeHeader === this.getConfig().mode;
  }
  public verifyWebhookSignature(
    rawBody: Buffer,
    signature: string | undefined
  ): boolean {
    const config = this.getConfig();

    if (
      !signature ||
      !/^[A-Za-z0-9+/]{43}=$/.test(signature)
    ) {
      return false;
    }

    const expected = createHmac('sha256', config.webhookSecret)
      .update(rawBody)
      .digest();

    const received = Buffer.from(signature, 'base64');

    if (received.length !== expected.length) {
      return false;
    }

    return timingSafeEqual(expected, received);
  }

  public parseWebhookPayload(
    payload: unknown
  ): PaypackWebhookPayload {
    if (!payload || typeof payload !== 'object') {
      throw new AppError('Invalid Paypack webhook payload.', 400);
    }

    const event = payload as Record<string, unknown>;
    const data = event.data as Record<string, unknown> | undefined;

    if (
      typeof event.event_id !== 'string' ||
      !event.event_id.trim() ||
      event.kind !== 'transaction:processed' ||
      !data ||
      typeof data.ref !== 'string' ||
      !data.ref.trim() ||
      !['CASHIN', 'CASHOUT'].includes(String(data.kind)) ||
      typeof data.amount !== 'number' ||
      !Number.isSafeInteger(data.amount) ||
      data.amount <= 0 ||
      !['pending', 'successful', 'failed'].includes(
        String(data.status).toLowerCase()
      )
    ) {
      throw new AppError('Invalid Paypack webhook event data.', 400);
    }

    const status = String(data.status).toLowerCase() as PaypackTransactionStatus;

    return {
      event_id: event.event_id,
      kind: 'transaction:processed',
      data: {
        ref: data.ref,
        kind: data.kind as 'CASHIN' | 'CASHOUT',
        amount: data.amount,
        status,
        ...(typeof data.client === 'string'
          ? { client: data.client }
          : {}),
      },
    };
  }
}