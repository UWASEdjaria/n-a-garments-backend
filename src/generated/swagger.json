	"paths": {
		"/wishlist": {
			"get": {
				"operationId": "GetWishlist",
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WishlistResponse"
								}
							}
						}
					}
				},
				"description": "Get current user's wishlist",
				"tags": [
					"Wishlist"
				],
				"security": [
					{
						"jwt": [
							"CUSTOMER"
						]
					}
				],
				"parameters": []
			}
		},
		"/wishlist/{productId}": {
			"post": {
				"operationId": "AddItem",
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WishlistResponse"
								}
							}
						}
					},
					"404": {
						"description": "Product not found"
					}
				},
				"description": "Add a product to wishlist",
				"tags": [
					"Wishlist"
				],
				"security": [
					{
						"jwt": [
							"CUSTOMER"
						]
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "productId",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			},
			"delete": {
				"operationId": "RemoveItem",
				"responses": {
					"200": {
						"description": "Success",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WishlistResponse"
								}
							}
						}
					},
					"404": {
						"description": "Item not in wishlist"
					}
				},
				"description": "Remove a product from wishlist",
				"tags": [
					"Wishlist"
				],
				"security": [
					{
						"jwt": [
							"CUSTOMER"
						]
					}
				],
				"parameters": [
					{
						"in": "path",
						"name": "productId",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				]
			}
		},
		"/stock": {
			"get": {
				"operationId": "ListStockEntries",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"totalPages": {
											"type": "number",
											"format": "double"
										},
										"data": {
											"items": {
												"$ref": "#/components/schemas/StockEntry"
											},
											"type": "array"
										}
									},
									"required": [
										"totalPages",
										"data"
									],
									"type": "object"
								}
							}
						}
					}
				},
				"tags": [
					"Stock"
				],
				"security": [
					{
						"jwt": [
							"ADMIN"
						]
					}
				],
				"parameters": [
					{
						"in": "query",
						"name": "page",
						"required": false,
