{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/**/*.controller.ts",
    "src/controllers/**/*.ts"
  ],
  "routes": {
    "routesDir": "src/generated",
    "middleware": "express"
  },
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "info": {
      "title": "N&A Tailors REST API",
      "version": "1.0.0",
      "description": "Backend API documentation for N&A Tailors tailoring, e-commerce, and custom order platform."
    },
    "securityDefinitions": {
      "jwt": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}