{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/**/*.controller.ts",
    "src/controllers/**/*.ts"
  ],
  "routes": {
    "routesDir": "src/generated",
    "esm": true,
    "authenticationModule": "src/config/authentication.ts",
    "middleware": "express"
  },
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "name": "na-garments REST API",
    "version": "1.0.0",
    "description": "Backend API documentation for na-garments tailoring, e-commerce, and custom order platform.",
    "securityDefinitions": {
      "jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}