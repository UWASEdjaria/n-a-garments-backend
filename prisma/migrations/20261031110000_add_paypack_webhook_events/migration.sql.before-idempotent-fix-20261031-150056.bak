ALTER TABLE "Payment"
ADD COLUMN "providerEventId" TEXT;

CREATE UNIQUE INDEX "Payment_providerEventId_key"
ON "Payment"("providerEventId");

CREATE TABLE "PaypackWebhookEvent" (
    "id" TEXT NOT NULL,
    "eventId" TEXT NOT NULL,
    "transactionRef" TEXT NOT NULL,
    "payload" JSONB NOT NULL,
    "processedAt" TIMESTAMP(3),
    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "updatedAt" TIMESTAMP(3) NOT NULL,
    CONSTRAINT "PaypackWebhookEvent_pkey" PRIMARY KEY ("id")
);

CREATE UNIQUE INDEX "PaypackWebhookEvent_eventId_key"
ON "PaypackWebhookEvent"("eventId");

CREATE INDEX "PaypackWebhookEvent_transactionRef_processedAt_idx"
ON "PaypackWebhookEvent"("transactionRef", "processedAt");